{
  "name": "hl",
  "productName": "HL",
  "version": "1.0.0",
  "description": "HL Video Editor — Professional Multi-Track Video Editor for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "node electron/dev.cjs",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && electron-builder --win nsis:x64"
  },
  "keywords": [
    "video-editor",
    "hl",
    "vnest",
    "timeline",
    "ffmpeg",
    "portable-project",
    "desktop"
  ],
  "author": "HL Systems",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.hl.videoeditor",
    "productName": "HL",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/@ffprobe-installer/win32-x64/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/**",
      "**/node_modules/@ffprobe-installer/**",
      "**/node_modules/onnxruntime-web/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HL-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HL",
      "artifactName": "HL-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "HL",
      "runAfterFinish": true
    },
    "fileAssociations": [
      {
        "ext": "vnest",
        "name": "HL Project",
        "description": "HL Portable Video Project Package",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@xenova/transformers": "^2.17.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "onnxruntime-node": "^1.14.0",
    "onnxruntime-web": "^1.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
